# Neon (pakai connection string "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Rahasia untuk menandatangani sesi login. Minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cloudinary (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hanya dipakai oleh `npm run db:setup` untuk membuat akun admin pertama
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
